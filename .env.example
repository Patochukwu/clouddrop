# ─── AWS ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name

# ─── PostgreSQL ─────────────────────────────────────────
#
# OPTION A — Docker (local, no account needed):
#   1. Run: docker-compose up -d
#   2. Use the connection string below as-is (no changes needed)
#
# DATABASE_URL=postgresql://postgres:password@localhost:5432/clouddrop
#
# OPTION B — Neon.tech (free cloud DB, no Docker needed):
#   1. Sign up free at https://neon.tech
#   2. Create a project → copy the connection string
#   3. Paste it below (it includes ?sslmode=require at the end)
#
# DATABASE_URL=postgresql://your-user:your-password@your-host.neon.tech/clouddrop?sslmode=require
#
# Uncomment and fill in ONE of the above:
DATABASE_URL=

# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Client ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
