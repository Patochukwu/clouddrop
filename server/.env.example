# ─── AWS S3 Configuration ─────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

# ─── PostgreSQL Database Connection ───────────────────────────
# OPTION A — Docker (local, no account needed):
#   1. Run: docker-compose up -d
#   2. Use the connection string below (uncomment it):
# DATABASE_URL=postgresql://postgres:password@localhost:5433/clouddrop
#
# OPTION B — Neon.tech (free cloud DB, no Docker needed):
#   1. Sign up free at https://neon.tech
#   2. Create a project → copy the connection string
#   3. Paste and uncomment it below:
# DATABASE_URL=postgresql://your-user:your-password@your-host.neon.tech/clouddrop?sslmode=require

DATABASE_URL=

# ─── Express Server Configuration ──────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
